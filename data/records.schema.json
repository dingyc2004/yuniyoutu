{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuniyoutu.local/schemas/records.schema.json",
  "title": "FishingRecordCollection",
  "description": "一次钓鱼过程结束后生成的结构化记录集合。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "user_id",
      "start_time",
      "end_time",
      "duration_seconds",
      "location_name",
      "fish_count",
      "fish_weight",
      "images",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "id": { "type": "string", "description": "集合内唯一记录 ID。" },
      "user_id": { "type": "string", "description": "用户 ID。" },
      "start_time": { "type": "string", "format": "date-time" },
      "end_time": { "type": "string", "format": "date-time" },
      "duration_seconds": { "type": "integer", "minimum": 0 },
      "fishing_spot_name": { "type": ["string", "null"] },
      "location_name": { "type": "string" },
      "latitude": { "type": ["number", "null"] },
      "longitude": { "type": ["number", "null"] },
      "weather": { "type": ["string", "null"] },
      "temperature": { "type": ["number", "null"] },
      "fish_count": { "type": "integer", "minimum": 0 },
      "fish_weight": { "type": "number", "minimum": 0 },
      "fish_species": { "type": ["string", "null"] },
      "catch_entries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "caught_at", "species", "weight"],
          "properties": {
            "id": { "type": "string" },
            "caught_at": { "type": "string", "format": "date-time" },
            "species": { "type": "string" },
            "weight": { "type": "number", "minimum": 0 },
            "length_cm": { "type": ["number", "null"], "minimum": 0 },
            "note": { "type": ["string", "null"] }
          }
        }
      },
      "fishing_method": { "type": ["string", "null"] },
      "bait": { "type": ["string", "null"] },
      "note": { "type": ["string", "null"] },
      "images": { "type": "array", "items": { "type": "string" } },
      "is_blank_trip": { "type": "boolean" },
      "blank_reason": { "type": ["string", "null"] },
      "max_single_weight": { "type": ["number", "null"], "minimum": 0 },
      "equipment_ids": { "type": "array", "items": { "type": "string" } },
      "water_type": { "type": ["string", "null"] },
      "record_template": { "type": ["string", "null"] },
      "tide": { "type": ["string", "null"] },
      "wave_level": { "type": ["string", "null"] },
      "boat_name": { "type": ["string", "null"] },
      "captain_name": { "type": ["string", "null"] },
      "trip_cost": { "type": ["number", "null"], "minimum": 0 },
      "privacy_level": { "type": "string" },
      "created_at": { "type": "string", "format": "date-time" },
      "updated_at": { "type": "string", "format": "date-time" }
    }
  }
}
