{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuniyoutu.local/schemas/posts.schema.json",
  "title": "CatchPostCollection",
  "description": "鱼获、空军、探点等社区帖子集合。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "user_id",
      "post_type",
      "format",
      "author",
      "title",
      "content",
      "excerpt",
      "tags",
      "likes",
      "comments",
      "saves",
      "coverTone",
      "visibility",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "id": { "type": "string" },
      "user_id": { "type": "string" },
      "post_type": { "type": "string" },
      "format": { "type": "string" },
      "author": { "type": "string" },
      "avatar": { "type": "string" },
      "title": { "type": "string" },
      "content": { "type": "string" },
      "excerpt": { "type": "string" },
      "meta": { "type": "string" },
      "poi_id": { "type": ["string", "null"] },
      "poi_name": { "type": ["string", "null"] },
      "record_id": { "type": ["string", "null"] },
      "content_type": { "type": ["string", "null"] },
      "fish_species": { "type": "array", "items": { "type": "string" } },
      "tags": { "type": "array", "items": { "type": "string" } },
      "images": { "type": "array", "items": { "type": "string" } },
      "likes": { "type": "integer", "minimum": 0 },
      "comments": { "type": "integer", "minimum": 0 },
      "saves": { "type": "integer", "minimum": 0 },
      "coverTone": { "type": "string" },
      "visibility": { "type": "string" },
      "location_visibility": { "type": "string" },
      "location_text": { "type": ["string", "null"] },
      "location_area_name": { "type": ["string", "null"] },
      "latitude": { "type": ["number", "null"] },
      "longitude": { "type": ["number", "null"] },
      "equipment_ids": { "type": "array", "items": { "type": "string" } },
      "created_at": { "type": "string", "format": "date-time" },
      "updated_at": { "type": "string", "format": "date-time" }
    }
  }
}
