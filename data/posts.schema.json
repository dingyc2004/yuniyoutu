{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuniyoutu.local/schemas/posts.schema.json",
  "title": "CatchPostCollection",
  "description": "鱼获、空军、探点等社区帖子集合。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "post_type",
      "format",
      "author",
      "title",
      "content",
      "excerpt",
      "tags",
      "likes",
      "comments",
      "saves",
      "coverTone",
      "visibility",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "id": { "type": "string", "description": "集合内唯一帖子 ID。" },
      "post_type": { "type": "string", "description": "帖子类型，如鱼获、空军、探点。" },
      "format": { "type": "string", "description": "内容形式，如图文、视频。" },
      "author": { "type": "string", "description": "作者昵称。" },
      "avatar": { "type": "string", "description": "头像占位字符或头像地址。" },
      "title": { "type": "string", "description": "帖子标题。" },
      "content": { "type": "string", "description": "帖子正文。" },
      "excerpt": { "type": "string", "description": "列表摘要。" },
      "meta": { "type": "string", "description": "列表辅助信息。" },
      "poi_id": { "type": ["string", "null"], "description": "关联 POI ID。" },
      "poi_name": { "type": ["string", "null"], "description": "关联 POI 名称。" },
      "fish_species": { "type": "array", "items": { "type": "string" }, "description": "鱼种。" },
      "tags": { "type": "array", "items": { "type": "string" }, "description": "话题标签。" },
      "images": { "type": "array", "items": { "type": "string" }, "description": "图片或视频资源地址。" },
      "likes": { "type": "integer", "minimum": 0, "description": "点赞数。" },
      "comments": { "type": "integer", "minimum": 0, "description": "评论数。" },
      "saves": { "type": "integer", "minimum": 0, "description": "收藏数。" },
      "coverTone": { "type": "string", "description": "前端封面色调枚举，如 blue、green、amber、purple。" },
      "visibility": { "type": "string", "description": "可见性，如 public、friends、private。" },
      "location_text": { "type": ["string", "null"], "description": "展示位置文本。" },
      "latitude": { "type": ["number", "null"], "description": "发帖纬度。" },
      "longitude": { "type": ["number", "null"], "description": "发帖经度。" },
      "created_at": { "type": "string", "format": "date-time", "description": "创建时间。" },
      "updated_at": { "type": "string", "format": "date-time", "description": "更新时间。" }
    }
  }
}
