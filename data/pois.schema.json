{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuniyoutu.local/schemas/pois.schema.json",
  "title": "FishingPOICollection",
  "description": "垂钓 POI 集合。每个对象代表一个经过垂钓语义增强的钓点、钓场或规则提示点。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "type",
      "city",
      "address",
      "location",
      "lng",
      "lat",
      "distance",
      "distance_m",
      "score",
      "fish",
      "tags",
      "reason",
      "risk",
      "risk_flags",
      "is_banned",
      "updated_at"
    ],
    "properties": {
      "id": { "type": "string", "description": "集合内唯一 POI ID。" },
      "name": { "type": "string", "description": "钓点名称。" },
      "type": { "type": "string", "description": "钓点类型，如野钓、钓场、禁钓提示。" },
      "category": { "type": "string", "description": "更细的业务分类。" },
      "city": { "type": "string", "description": "城市名称。" },
      "district": { "type": "string", "description": "区县名称。" },
      "address": { "type": "string", "description": "展示地址。" },
      "location": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$", "description": "经纬度字符串，格式 lng,lat。" },
      "lng": { "type": "number", "description": "经度。" },
      "lat": { "type": "number", "description": "纬度。" },
      "distance": { "type": "string", "description": "前端展示距离，如 2.4km。" },
      "distance_m": { "type": "integer", "minimum": 0, "description": "距离，单位米。" },
      "score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "综合展示分。" },
      "fish": { "type": "array", "items": { "type": "string" }, "description": "常见鱼种。" },
      "tags": { "type": "array", "items": { "type": "string" }, "description": "展示标签。" },
      "reason": { "type": "string", "description": "推荐理由。" },
      "risk": { "type": "string", "description": "安全或合规提示。" },
      "risk_flags": { "type": "array", "items": { "type": "string" }, "description": "机器可读风险标记。" },
      "is_banned": { "type": "boolean", "description": "是否存在禁钓提示。" },
      "facilities": { "type": "array", "items": { "type": "string" }, "description": "设施能力。" },
      "social_heat": { "type": "integer", "minimum": 0, "maximum": 100, "description": "社交热度分。" },
      "fish_condition_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "鱼情分。" },
      "compliance_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "合规分。" },
      "weather_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "天气适配分。" },
      "facility_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "设施便利分。" },
      "recent_posts_count": { "type": "integer", "minimum": 0, "description": "近期鱼获或复盘帖数量。" },
      "suitability": { "type": "array", "items": { "type": "string" }, "description": "适配钓法或场景。" },
      "compliance_note": { "type": "string", "description": "规则说明。" },
      "updated_at": { "type": "string", "format": "date-time", "description": "更新时间。" }
    }
  }
}
