{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReactionCollection",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "post_id", "user_id", "reaction_type", "created_at"],
    "properties": {
      "id": { "type": "string" },
      "post_id": { "type": "string" },
      "user_id": { "type": "string" },
      "reaction_type": { "type": "string", "enum": ["like", "save"] },
      "created_at": { "type": "string", "format": "date-time" }
    }
  }
}
