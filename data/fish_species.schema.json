{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuniyoutu.local/schemas/fish_species.schema.json",
  "title": "FishSpeciesCollection",
  "description": "鱼种百科集合。每个对象代表一个可在钓点卡片中展开的鱼种介绍。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "gallery", "length", "weight", "habits", "strategy", "season", "risk_note"],
    "properties": {
      "id": { "type": "string", "description": "集合内唯一鱼种 ID。" },
      "name": { "type": "string", "description": "鱼种展示名。" },
      "alias": { "type": "array", "items": { "type": "string" }, "description": "别名。" },
      "gallery": {
        "type": "array",
        "description": "图集数据。当前可用占位色调，后续可扩展真实图片 URL。",
        "items": {
          "type": "object",
          "required": ["title", "subtitle"],
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "tone": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      },
      "length": { "type": "string", "description": "常见体长。" },
      "weight": { "type": "string", "description": "常见重量。" },
      "habits": { "type": "string", "description": "生活习性。" },
      "strategy": { "type": "array", "items": { "type": "string" }, "description": "作钓攻略。" },
      "season": { "type": "string", "description": "活跃季节。" },
      "risk_note": { "type": "string", "description": "安全或合规提醒。" }
    }
  }
}
